# VERQIA — modèle d'environnement sans données réelles ni secrets.
# Ne copiez jamais ce fichier avec des valeurs inventées pour tenter un déploiement Production.
# Laisser les champs légaux vides maintient volontairement le statut NO-GO Production.

# Cible de contrôle locale uniquement : laisser vide pour développement/Preview.
# Utiliser "production" localement seulement pour tester les gates obligatoires.
VERQIA_BUILD_TARGET=
# L'indexation est désactivée par défaut. Elle exige aussi une configuration Production complète.
VERQIA_INDEXING_ENABLED=false
# Réservé à une revue locale ou Preview autorisée. Interdit dans tout build Production.
NEXT_PUBLIC_LOCAL_PRICING_REVIEW=false

# Domaine officiel : HTTPS requis avant indexation ou Production.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CITY=

# Identité légale — renseigner uniquement après décision du fondateur et vérification documentaire.
NEXT_PUBLIC_LEGAL_IDENTITY=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
# Fournir l'un des deux identifiants officiels, jamais une valeur fictive.
NEXT_PUBLIC_REGISTRATION_NUMBER=
NEXT_PUBLIC_RCCM=
NEXT_PUBLIC_SHARE_CAPITAL=
NEXT_PUBLIC_TAX_ID=
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=

# Coordonnées publiques — D-017 les maintient désactivées dans le code à ce stade.
# Ne pas les renseigner ni les activer sans décision écrite et revue juridique.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CALENDLY=

# Hébergement — remplir uniquement avec les informations vérifiées du fournisseur choisi.
NEXT_PUBLIC_HOSTING_PROVIDER=
NEXT_PUBLIC_HOSTING_ADDRESS=
NEXT_PUBLIC_HOSTING_CONTACT=

# Preuve traçable de la revue juridique : référence datée non publique (ex. registre interne).
# Cette variable ne remplace pas la revue effective et ne doit pas contenir de données personnelles.
LEGAL_REVIEW_REFERENCE=

# Médias requis par le gate Production. Les sources vidéo par défaut sont locales ; les affiches,
# sous-titres et illustrations doivent provenir de fichiers validés dans public/ ou d'URL HTTPS approuvées.
NEXT_PUBLIC_MEDIA_HOME_RECAP_SRC=
NEXT_PUBLIC_MEDIA_HOME_RECAP_MOBILE_SRC=
NEXT_PUBLIC_MEDIA_HOME_RECAP_POSTER=
NEXT_PUBLIC_MEDIA_HOME_RECAP_CAPTIONS_FR=
NEXT_PUBLIC_MEDIA_HOME_RECAP_CAPTIONS_EN=
NEXT_PUBLIC_MEDIA_PRODUCT_DETAIL_SRC=
NEXT_PUBLIC_MEDIA_PRODUCT_DETAIL_MOBILE_SRC=
NEXT_PUBLIC_MEDIA_PRODUCT_DETAIL_POSTER=
NEXT_PUBLIC_MEDIA_PRODUCT_DETAIL_CAPTIONS_FR=
NEXT_PUBLIC_MEDIA_PRODUCT_DETAIL_CAPTIONS_EN=
NEXT_PUBLIC_MEDIA_AUDIENCE_COMMERCE_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_PROFESSIONAL_SERVICES_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_STARTUPS_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_SMES_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_B2B_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_WHOLESALERS_SRC=
NEXT_PUBLIC_MEDIA_AUDIENCE_LARGE_ORGANIZATIONS_SRC=

# Assets de marque effectivement rendus. Laisser vide utilise les assets locaux validés du dépôt.
NEXT_PUBLIC_LOGO_SYMBOL_PATH=
NEXT_PUBLIC_LOGO_WORDMARK_PATH=
# Variantes non rendues par le site public actuel : documentées pour inventaire, non exigées par le gate.
NEXT_PUBLIC_LOGO_PATH=
NEXT_PUBLIC_LOGO_SLOGAN_PATH=
NEXT_PUBLIC_LOGO_ONYX_PATH=
NEXT_PUBLIC_LOGO_ROUND_ICON_PATH=

# Authentification : désactivée dans le périmètre actuel. Conserver vides ; n'ajoutez jamais de clé de service.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
