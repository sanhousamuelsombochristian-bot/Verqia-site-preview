{
  "name": "verqia-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/check-indexing.mjs && next build --webpack && node scripts/check-rendered-placeholders.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:e2e": "NEXT_PUBLIC_SCROLL_PRESET=balanced npm run build && playwright test",
    "test:e2e:pricing-review": "NEXT_PUBLIC_SCROLL_PRESET=balanced NEXT_PUBLIC_LOCAL_PRICING_REVIEW=true npm run build && playwright test --config=playwright.pricing-review.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@types/node": "^24.10.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "^16.4.5",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
